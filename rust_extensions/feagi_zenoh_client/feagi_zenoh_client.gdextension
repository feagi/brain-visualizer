[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]
macos.debug = "target/debug/libfeagi_zenoh_client.dylib"
macos.release = "target/release/libfeagi_zenoh_client.dylib"
windows.debug.x86_64 = "target/x86_64-pc-windows-msvc/debug/feagi_zenoh_client.dll"
windows.release.x86_64 = "target/x86_64-pc-windows-msvc/release/feagi_zenoh_client.dll"
linux.debug.x86_64 = "target/x86_64-unknown-linux-gnu/debug/libfeagi_zenoh_client.so"
linux.release.x86_64 = "target/x86_64-unknown-linux-gnu/release/libfeagi_zenoh_client.so"
linux.debug.arm64 = "target/aarch64-unknown-linux-gnu/debug/libfeagi_zenoh_client.so"
linux.release.arm64 = "target/aarch64-unknown-linux-gnu/release/libfeagi_zenoh_client.so"
