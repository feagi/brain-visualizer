[node name="mp_encoding" type="HBoxContainer" parent="PanelContainer/MemoryParameters"]
layout_mode = 2
tooltip_text = "How upstream membrane potentials shape memories. None: firing pattern only. MP Learning: store MPs and replay them. MP Differential: the same MP change (e.g. 2 to 4 and 7 to 9) forms one memory. MP Ratio: the same growth ratio (e.g. 2 to 4 and 7 to 14) forms one memory. Change modes need Temporal Depth of 2 or more and do not replay."

