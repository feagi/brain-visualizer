[node name="Plasticity_Window" type="LineEdit" parent="SubRow/Panel/Fields"]
custom_minimum_size = Vector2(80, 0)
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 4
tooltip_text = "Window (bursts): a synapse is potentiated or depressed only if its source/destination neurons fired within the last Window bursts.\nBoth fired: trace += Constant x LTP x. Only one fired: trace -= Constant x LTD x."
alignment = 1
script = ExtResource("15_7qf8u")
initial_int = 3

[node name="Label_Constant" type="Label" parent="SubRow/Panel/Fields"]
layout_mode = 2
size_flags_vertical = 4
text = "Constant"

[node name="Plasticity_Constant" type="LineEdit" parent="SubRow/Panel/Fields"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 4
tooltip_text = "Constant: base size of each trace change per burst.\nBoth fired: trace += Constant x LTP x. One side fired: trace -= Constant x LTD x. Each step is clamped to 0-255."
alignment = 1
script = ExtResource("4_y0rve")
initial_float = 1.0

[node name="Label_LTP" type="Label" parent="SubRow/Panel/Fields"]
layout_mode = 2
size_flags_vertical = 4
text = "LTP ×"

[node name="LTP_Multiplier" type="LineEdit" parent="SubRow/Panel/Fields"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 4
tooltip_text = "LTP x: scales the trace increase when both neurons fired within the Window (Constant x LTP x). 0 disables potentiation."
alignment = 1
script = ExtResource("4_y0rve")
initial_float = 1.0

[node name="Label_LTD" type="Label" parent="SubRow/Panel/Fields"]
layout_mode = 2
size_flags_vertical = 4
text = "LTD ×"

[node name="LTD_Multiplier" type="LineEdit" parent="SubRow/Panel/Fields"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 4
tooltip_text = "LTD x: scales the trace decrease when only one neuron fired within the Window (Constant x LTD x). Ignored on associative-memory mappings."
